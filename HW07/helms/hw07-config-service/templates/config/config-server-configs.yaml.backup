apiVersion: v1
kind: ConfigMap
metadata:
  name: config-server-configs
  labels:
    {{- include "hw07-config-service.labels" . | nindent 4 }}
    app.kubernetes.io/component: config-service
data:
  # Общий конфиг для всех сервисов
  application.yml: |
    spring:
      output:
        ansi:
          enabled: ALWAYS

    server:
      error:
        whitelabel:
          enabled: false


    # Настройки сервисов
    app:
      services:
        user-service:
          url: http://${USER_SERVICE_HOST:localhost}:${USER_SERVICE_PORT:8082}
          endpoints:
            profile: /internal/profile
            me: /internal/me

        auth-service:
          url: http://${AUTH_SERVICE_HOST:localhost}:${AUTH_SERVICE_PORT:8081}
          endpoints:
            validate: /internal/validate

        billing-service:
          url: http://${BILLING_SERVICE_HOST:localhost}:${BILLING_SERVICE_PORT:8083}
          endpoints:
            order: /internal/order


  # Конфиг для api-gateway
  api-gateway.yml: |
    server:
      port: 8079

    spring:
      application:
        name: api-gateway
      cloud:
        gateway:
          server:
            webflux:
              httpclient:
                connect-timeout: 1000
                response-timeout: 5s




  # Конфиг для auth-service
  auth-service.yml: |
    server:
      port: 8081

    spring:
      application:
        name: auth-service

      datasource:
        url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:microservices_db}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        driver-class-name: org.postgresql.Driver

      jpa:
        open-in-view: false
        hibernate:
          ddl-auto: validate
        show-sql: false
        properties:
          hibernate:
            default_schema: auth

      liquibase:
        change-log: classpath:db/changelog/auth-service.db.changelog-master.xml
        default-schema: auth
        liquibase-schema: public

      kafka:
        bootstrap-servers: ${KAFKA_BOOTSTRAP:kafka.kafka:9092}
        client-id: auth-service-producer

        properties:
          security.protocol: ${KAFKA_SECURITY_PROTOCOL:SASL_PLAINTEXT}
          sasl.mechanism: ${KAFKA_SASL_MECHANISM:PLAIN}
          sasl.jaas.config: ${KAFKA_JAAS_CONFIG:org.apache.kafka.common.security.plain.PlainLoginModule required username="${KAFKA_USER:user1}" password="${KAFKA_PASSWORD}";}


  # Конфиг для billing-service
  billing-service.yml: |
    server:
      port: 8083

    spring:
      application:
        name: billing-service
      datasource:
        url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:microservices_db}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        driver-class-name: org.postgresql.Driver




  # Конфиг для notification-service
  notification-service.yml: |
    server:
      port: 8085

    spring:
      application:
        name: notification-service
      datasource:
        url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:microservices_db}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        driver-class-name: org.postgresql.Driver




  # Конфиг для order-service
  order-service.yml: |
    server:
      port: 8084

    spring:
      application:
        name: order-service
      datasource:
        url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:microservices_db}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        driver-class-name: org.postgresql.Driver

      jpa:
        open-in-view: false
        hibernate:
          ddl-auto: validate
        show-sql: false
        properties:
          hibernate:
            default_schema: order_service


  # Конфиг для user-service
  user-service.yml: |
    server:
      port: 8082

    spring:
      application:
        name: user-service
      datasource:
        url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:microservices_db}
        username: ${DB_USER:postgres}
        password: ${DB_PASSWORD:postgres}
        driver-class-name: org.postgresql.Driver
