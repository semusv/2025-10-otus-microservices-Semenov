<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1767981146000-0" author="semva">
        <sql>
            CREATE SCHEMA IF NOT EXISTS order_service;
        </sql>
    </changeSet>

    <changeSet id="1767981146000-1" author="semva">
        <createTable tableName="orders">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_orders"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" name="updated_at"
                    type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT"/>
        </createTable>
    </changeSet>

    <changeSet id="1767981146000-2" author="semva">
        <dropDefaultValue
                tableName="orders"
                columnName="created_at"
                columnDataType="TIMESTAMP"/>
    </changeSet>
</databaseChangeLog>
