<configuration scan="true" scanPeriod="10 seconds">
    <jmxConfigurator />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%green(%d{HH:mm:ss.SSS}) %highlight([%thread]) %highlight(%-5level) %cyan(%logger{36}) - %yellow([%X{X-Request-Id}]) %msg%n</pattern>
        </encoder>
    </appender>

