		{
			"name": "User 1 - Get Profile (Verify Changes)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    var storedFirstName = pm.environment.get(\"user1_profile_firstName\");",
							"    var storedLastName = pm.environment.get(\"user1_profile_lastName\");",
							"    ",
							"    if (storedFirstName) {",
							"        pm.test(\"First name matches\", function () {",
							"            pm.expect(jsonData.firstName).to.eql(storedFirstName);",
							"        });",
							"    }",
							"    ",
							"    if (storedLastName) {",
							"        pm.test(\"Last name matches\", function () {",
							"            pm.expect(jsonData.lastName).to.eql(storedLastName);",
							"        });",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user1_token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/profile",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"profile"
					]
				}
			},
			"response": []
