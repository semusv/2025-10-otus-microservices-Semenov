	"item": [
		{
			"name": "User 1 - Registration",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate random data for User 1",
							"var randomUsername = 'user1_' + Math.random().toString(36).substring(2, 15);",
							"var randomEmail = 'user1_' + Math.random().toString(36).substring(2, 15) + '@example.com';",
							"var randomPassword = 'pass' + Math.random().toString(36).substring(2, 15);",
							"",
							"pm.environment.set(\"user1_username\", randomUsername);",
							"pm.environment.set(\"user1_email\", randomEmail);",
							"pm.environment.set(\"user1_password\", randomPassword);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.environment.set(\"user1_token\", jsonData.token);",
							"    pm.environment.set(\"user1_id\", jsonData.userId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{user1_username}}\",\n    \"email\": \"{{user1_email}}\",\n    \"password\": \"{{user1_password}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
