		{
			"name": "User 2 - Try to Access User 1 Profile (Should Fail)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 or 403\", function () {",
							"    // User 2 can only access their own profile, not User 1's",
							"    // Since the API doesn't allow accessing other users' profiles by ID,",
							"    // User 2 will get their own profile or 404 if profile doesn't exist",
							"    // The security check ensures they can only see their own data",
							"    var statusCode = pm.response.code;",
							"    ",
							"    if (statusCode === 200) {",
							"        // If 200, verify it's User 2's profile, not User 1's",
							"        var jsonData = pm.response.json();",
							"        var user2Id = pm.environment.get(\"user2_id\");",
							"        var user1Id = pm.environment.get(\"user1_id\");",
							"        ",
							"        pm.test(\"Profile belongs to User 2, not User 1\", function () {",
							"            pm.expect(jsonData.userId.toString()).to.eql(user2Id);",
							"            if (user1Id) {",
							"                pm.expect(jsonData.userId.toString()).to.not.eql(user1Id);",
							"            }",
							"        });",
							"    } else {",
							"        pm.expect(statusCode).to.be.oneOf([404, 403]);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user2_token}}"
					}
				],
