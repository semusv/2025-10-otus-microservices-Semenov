		{
			"name": "CreateRandomUser_1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Создан\", function () {\r",
							"    pm.response.to.have.status(\"Created\");\r",
							"});\r",
							"\r",
							"\r",
							"// Получаем сырое тело запроса\r",
							"var requestBody = pm.request.body.raw;\r",
							"\r",
							"try {\r",
							"    var requestData = JSON.parse(requestBody);\r",
							"    pm.environment.set(\"username\", requestData.username);\r",
							"    pm.environment.set(\"email\", requestData.email);\r",
							"    pm.environment.set(\"password\", requestData.password);\r",
							"    pm.environment.set(\"firstName\", requestData.firstName);\r",
							"    pm.environment.set(\"lastName\", requestData.lastName);\r",
							"    pm.environment.set(\"phone\", requestData.phone);\r",
							"} catch (e) {\r",
							"    console.log(\"Ошибка парсинга тела запроса:\", e);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
