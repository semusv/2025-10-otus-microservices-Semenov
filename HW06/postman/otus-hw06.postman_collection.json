		{
			"name": "me",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"\r",
							"var responseData = pm.response.json();\r",
							"// Получаем значения переменных из окружения\r",
							"var phoneNew = pm.environment.get(\"phoneNew\");\r",
							"var phoneOld = pm.environment.get(\"phone\");\r",
							"var emailNew = pm.environment.get(\"emailNew\");\r",
							"var emailOld = pm.environment.get(\"email\");\r",
							"\r",
							"pm.test(\"phone changed\", function () {  \r",
							"    pm.expect(responseData.phone).to.eql(phoneNew);  \r",
							"    pm.expect(responseData.phone).not.eql(phoneOld)     \r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"email changed\", function () {\r",
							"    pm.expect(responseData.email).to.eql(emailNew);     \r",
							"    pm.expect(responseData.email).not.eql(emailOld)     \r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"console.log(\"проверка, что профиль поменялся\");"
