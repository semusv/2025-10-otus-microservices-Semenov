<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1769344290374-0" author="system" context="delivery-service">
        <sql>
            CREATE SCHEMA IF NOT EXISTS delivery_service;
        </sql>
    </changeSet>


    <changeSet id="1770555085817-1" author="semva (generated)" context="delivery-service">
        <createTable tableName="outbox_events">
            <column name="event_id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_outbox_events"/>
            </column>
            <column name="aggregate_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="correlation_id" type="VARCHAR(255)"/>
            <column name="event_type" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT"/>
            <column name="topic" type="VARCHAR(255)"/>
            <column name="published" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="DATETIME"/>
            <column name="retry_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(255)"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1770555085817-2" author="semva (generated)" context="delivery-service">
        <createTable tableName="reservation">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_reservation"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="saga_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="saga_step" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="compensated_by" type="UUID"/>
            <column name="compensates" type="UUID"/>
            <column defaultValueComputed="CURRENT_TIMESTAMP" name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP" name="updated_at"
                    type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>